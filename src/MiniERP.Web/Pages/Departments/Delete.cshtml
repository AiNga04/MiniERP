@page "{id:int}"
@model MiniERP.Web.Pages.Departments.DeleteModel
@{ ViewData["Title"] = "Xóa phòng ban"; }

<h1>Xóa phòng ban</h1>
<p>Bạn có muốn xóa phòng ban <strong>@Model.Department.DepartmentName</strong>?</p>
<p>Phòng ban sẽ ẩn khỏi danh sách; dữ liệu liên quan được giữ lại.</p>
<form method="post" asp-route-id="@Model.Department.DepartmentId">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-page="Index" class="btn btn-secondary">Hủy</a>
</form>
