@page "{id:int}"
@model MiniERP.Web.Pages.Positions.DetailsModel
@{ ViewData["Title"] = "Chi tiết chức vụ"; }

<h1>Chi tiết chức vụ</h1>
<partial name="_StatusMessage" />
<dl class="row">
    <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.Position.PositionId</dd>
    <dt class="col-sm-3">Tên chức vụ</dt><dd class="col-sm-9">@Model.Position.PositionName</dd>
</dl>
<a asp-page="Edit" asp-route-id="@Model.Position.PositionId" class="btn btn-primary">Sửa</a>
<a asp-page="Delete" asp-route-id="@Model.Position.PositionId" class="btn btn-outline-danger">Xóa</a>
<a asp-page="Index" class="btn btn-secondary">Danh sách</a>
